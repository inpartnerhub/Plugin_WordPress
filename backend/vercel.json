{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/[...path]"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "data/kb.json",
      "maxDuration": 60
    }
  }
}
