# WP Knowledge Chat backend configuration.
# Copy to backend/.env for local development (`npm run start:local` loads it).
# In production, set these as environment variables / secrets in your host. Never commit real values.

# --- Required -------------------------------------------------------------
# Primary AI provider: "openrouter" (this template) or "gemini" (the code default when unset).
# Set both API keys to get automatic failover to the other provider.
LLM_PROVIDER=openrouter

# OpenRouter API key (server-side only; never sent to browsers or WordPress). Required when LLM_PROVIDER=openrouter; optional otherwise (enables failover).
OPENROUTER_API_KEY=
# Primary model (OpenRouter model id).
OPENROUTER_MODEL=deepseek/deepseek-chat
# Optional comma-separated fallback models, tried by OpenRouter if the primary fails. Max 4.
# OPENROUTER_FALLBACK_MODELS=qwen/qwen-2.5-72b-instruct,google/gemini-2.5-flash

# Google Gemini API key (server-side only). Required when LLM_PROVIDER=gemini; optional otherwise (enables failover).
GEMINI_API_KEY=

# Shared HMAC secret for WordPress -> backend chat requests (min 32 chars).
# Must equal WP_KNOWLEDGE_CHAT_SHARED_SECRET in wp-config.php. Generate: npm run secret
CHAT_SHARED_SECRET=

# Bearer token for POST /api/index (min 32 chars, different from CHAT_SHARED_SECRET).
# Required by config validation even on Vercel/Netlify, where /api/index returns 501.
# Keep it off the WordPress server unless WordPress pushes content.
INDEX_API_TOKEN=

# --- Optional (defaults shown) --------------------------------------------
# HOST=127.0.0.1                 # use 0.0.0.0 on PaaS/containers
# PORT=8787
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=12000        # deadline per provider call incl. one retry (both providers)
# LLM_TOTAL_TIMEOUT_MS=18000     # both providers incl. failover; keep below the WordPress timeout (22 s)
# GEMINI_MAX_OUTPUT_TOKENS=220     # output cap for both providers
# KB_PATH=data/kb.json
# ALLOWED_SOURCE_HOSTS=inpartner.id,www.inpartner.id,inpartnerglobal.com,www.inpartnerglobal.com
# MAX_MESSAGE_CHARS=500
# RATE_LIMIT_PER_CLIENT_PER_MINUTE=8
# RATE_LIMIT_GLOBAL_PER_MINUTE=60
# DAILY_REQUEST_LIMIT=1000       # cost ceiling: Gemini calls per UTC day (fallbacks without a model call are free)
# RETRIEVAL_MIN_SCORE=1.0
# RETRIEVAL_TOP_K=4
# SIGNATURE_MAX_SKEW_SECONDS=300
# LOG_LEVEL=info

# --- WordPress side (wp-config.php, not this file) -------------------------
# define( 'WP_KNOWLEDGE_CHAT_BACKEND_URL', 'https://chat-api.example.com' );
# define( 'WP_KNOWLEDGE_CHAT_SHARED_SECRET', '<same value as CHAT_SHARED_SECRET>' );
# define( 'WP_KNOWLEDGE_CHAT_INDEX_API_TOKEN', '<same value as INDEX_API_TOKEN>' );
# Optional, only behind a reverse proxy/CDN: proxies whose X-Forwarded-For is trusted.
# define( 'WP_KNOWLEDGE_CHAT_TRUSTED_PROXIES', '<proxy IPs or CIDR ranges, comma-separated>' );
